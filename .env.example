# Copy to .env.local (or .env) and fill in. Never commit the real file.

# Supabase project URL (Project Settings -> API). Used only on the server.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase service_role key. SERVER ONLY (app/api/*). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 4-8 digit PIN for /dashboard and /tasks (checked on the server).
ADMIN_PIN=1234

# Optional: separate secret for signing the report-cooldown cookie.
# Defaults to SUPABASE_SERVICE_ROLE_KEY when unset.
# REPORT_COOKIE_SECRET=some-long-random-string

# Secret that signs login cookies. 32+ random characters. REQUIRED for login/register.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Only for `npm run seed:accounts` (local). Shared password for the fake demo accounts.
# DEMO_PASSWORD=choose-a-demo-password
