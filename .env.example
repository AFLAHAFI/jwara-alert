# Copy to .env.local (or .env) and fill in. Never commit the real file.

# Supabase project URL (Project Settings -> API). Used only on the server.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase service_role key. SERVER ONLY (app/api/*). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 4-8 digit PIN for /dashboard and /tasks (checked on the server).
ADMIN_PIN=1234

# Optional: separate secret for signing the report-cooldown cookie.
# Defaults to SUPABASE_SERVICE_ROLE_KEY when unset.
# REPORT_COOKIE_SECRET=some-long-random-string
